# Public managed service for invitation verification and AI programs.
# No API keys are needed locally. Override only for a self-hosted gateway.
ONE_RADIO_CLOUD_BASE_URL=https://openmusicradio-gateway.vercel.app
ONE_RADIO_AI_MODE=managed
ONE_RADIO_MANAGED_LLM_MODEL=deepseek-v4.1-flash
ONE_RADIO_MANAGED_TTS_MODEL=qwen-audio-3.0-tts-plus

# Local NeteaseCloudMusicApiEnhanced companion started by `npm run dev`.
NETEASE_API_BASE_URL=http://127.0.0.1:4320

PORT=4317
