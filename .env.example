# OpenMusicRadio managed service. Deploy `aliyun/fc-gateway` to Alibaba
# Function Compute and put the generated HTTPS endpoint here. Bailian keys
# belong only in Function Compute environment variables.
ONE_RADIO_CLOUD_BASE_URL=https://<your-function-endpoint>
ONE_RADIO_AI_MODE=managed
ONE_RADIO_MANAGED_LLM_MODEL=deepseek-v4.1-flash
ONE_RADIO_MANAGED_TTS_MODEL=cosyvoice-v2
NETEASE_API_BASE_URL=http://127.0.0.1:4320
PORT=4317
